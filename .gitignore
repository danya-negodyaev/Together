# Личные настройки: пароль комнаты и секрет.
# Сервер сам создаёт config.json при первом запуске, поэтому в репозиторий он не нужен.
config.json

# Состояние комнат (меняется во время работы сервера)
data/

# Фильмы: большие файлы, GitHub не принимает файлы больше 100 МБ.
# Оставляем только подсказку-txt, чтобы папка была в репозитории.
movies/*
!movies/*.txt

# Служебное
node_modules/
.idea/
*.log
Thumbs.db
desktop.ini
